# Copy this file to .env and adjust the values.
# Never commit your real .env file.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use SQLite (db.sqlite3) for local development.
# Example for PostgreSQL:
# DATABASE_URL=postgres://ledger:ledger@localhost:5440/ledger

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Host ports used by docker-compose (change them if they clash with other apps)
API_PORT=8010
DB_PORT=5440
